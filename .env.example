# Copy this file to .env and fill in your API tokens and configuration settings

# Hugging Face Hub settings
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# LangSmith settings for monitoring and tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=RAG-Knowledge-Base
OPENAI_API_KEY=your_openai_api_key_here

# Optional LangSmith endpoint (uncomment if using a custom endpoint)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Qdrant settings
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Oracle database settings for Text2SQL tool
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service_name
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
